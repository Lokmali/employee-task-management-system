# Copy to ".env" for local docker compose overrides.
# Never commit a real .env with production secrets.

# --- PostgreSQL ---
POSTGRES_DB=etms
DB_USERNAME=etms
DB_PASSWORD=etms
# Used by the backend container (service name "postgres" on the Docker network).
DB_URL=jdbc:postgresql://postgres:5432/etms

# --- JWT (use a long random secret in real deployments) ---
JWT_SECRET=LocalDevOnly-ChangeMe-EmployeeTaskMgmt-HS256-Secret-Key-32chars+
JWT_EXPIRATION_MS=86400000

# --- CORS: comma-separated frontend origins the browser may use ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend build (baked into the JS bundle) ---
# Must be a URL your browser can open (localhost when running compose on your PC).
VITE_API_URL=http://localhost:8080
